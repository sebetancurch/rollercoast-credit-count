# Copy to .env.local:  cp .env.example .env.local
#
# Only NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY carry the
# NEXT_PUBLIC_ prefix. The anon key is meant to be public — RLS is what decides
# what its bearer can see. A service-role key must never appear in this file.

# --- Supabase -------------------------------------------------------------
# Placeholders until the project is provisioned in step 2. `supabase start`
# prints the real local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-from-supabase-start

# --- Mock mode ------------------------------------------------------------
# While this is "true" the app serves the seeded fixtures in lib/mock/ and the
# session comes from the dev role switcher instead of Supabase Auth. Set it to
# "false" once the database and RLS policies exist. Server-only on purpose.
USE_MOCK_DATA=true
