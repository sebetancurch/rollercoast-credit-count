# Copy to .env.local:  cp .env.example .env.local
#
# Only these two carry the NEXT_PUBLIC_ prefix, because only these two are meant
# to reach the browser. The anon key grants nothing on its own — RLS decides
# what its bearer can see. A service-role key bypasses RLS entirely and must
# never appear here, in any variable, prefixed or not.

# Local development. `pnpm exec supabase start` prints both values; the anon key
# it emits is the CLI's fixed demo key and is the same on every machine.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-from-supabase-start

# For the hosted project, take both from the Supabase dashboard:
#   Project Settings → API → Project URL and the publishable/anon key.
